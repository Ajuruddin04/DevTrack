generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  COMPLETED
  ON_HOLD
}

enum JobApplicationStatus {
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  REJECTED
  WITHDRAWN
}

enum SkillProficiency {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

model User {
  id              Int              @id @default(autoincrement())
  name            String
  email           String           @unique
  password        String
  tasks           Task[]
  projects        Project[]
  jobApplications JobApplication[]
  skills          Skill[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model Task {
  id          Int          @id @default(autoincrement())
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?
  category    String?
  isDaily     Boolean      @default(false)
  userId      Int
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId   Int?
  project     Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([userId])
  @@index([userId, status])
  @@index([userId, dueDate])
}

model Project {
  id          Int           @id @default(autoincrement())
  name        String
  description String?
  status      ProjectStatus @default(PLANNING)
  techStack   String[]      @default([])
  repoUrl     String?
  liveUrl     String?
  userId      Int
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks       Task[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([userId])
}

model JobApplication {
  id              Int                  @id @default(autoincrement())
  company         String
  role            String
  location        String?
  salary          String?
  status          JobApplicationStatus @default(APPLIED)
  applicationDate DateTime             @default(now())
  interviewDate   DateTime?
  notes           String?
  jobUrl          String?
  userId          Int
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([userId])
  @@index([userId, status])
}

model Skill {
  id                 Int              @id @default(autoincrement())
  name               String
  category           String?
  proficiency        SkillProficiency @default(BEGINNER)
  progressPercentage Int              @default(0)
  userId             Int
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([userId, name])
  @@index([userId])
}
